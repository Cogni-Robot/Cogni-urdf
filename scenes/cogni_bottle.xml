<mujoco model="scene_bouteille">
  <!-- 1. On importe le robot complet -->
  <include file="COGNI_ROBOT.xml"/>
  <include file="visual.xml"/>

  <compiler angle="radian" meshdir="../meshes/" discardvisual="false"/>

  <asset>
    <mesh name="Waterbottle.obj" file="scenes/Waterbottle.obj" scale="0.005 0.005 0.005" />
  </asset>

  <worldbody>
    <!-- Lumière et Sol -->
    <light directional="true" pos="0 0 5" dir="0 0 -1" />
    <geom name="ground" type="plane" pos="0 0 -0.42" size="5 5 0.01" rgba="0.8 0.8 0.8 1" />

    <!-- 1. La Table -->
    <body name="table" pos="0.0 0 -0.02">
      <!-- Ajout de contype et conaffinity pour forcer la collision -->
      <geom type="box" size="0.4 0.5 0.02" rgba="0.6 0.4 0.2 1" contype="1" conaffinity="1" />
    </body>
    
    <!-- 2. La Bouteille -->
    <body name="bottle" pos="0.0 -0.3 0.04" euler="1.5 0.0 0">
      <freejoint/> 
      <geom type="mesh" mesh="Waterbottle.obj" size="0.03 0.08" rgba="0 0 1 0.5" mass="0.1" contype="1" conaffinity="1" />
    </body>
  </worldbody>
  
</mujoco>